    //   "🐧 编译内核 (RK3588)": "./scripts/build.sh rockchip rk3588 evb1 kernel",
    //   "🧹 清理构建产物": "./scripts/clean.sh",
    //   "📦 打包所有芯片": "./scripts/build-all.sh"
    // }

  }
}