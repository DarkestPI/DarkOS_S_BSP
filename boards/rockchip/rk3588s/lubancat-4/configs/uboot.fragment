# 使用本板设备树，SoC DTSI 和 U-Boot 启动描述沿用主线源码。
CONFIG_DEFAULT_DEVICE_TREE="rk3588s-lubancat-4"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3588s-lubancat-4.dtb"
CONFIG_OF_LIST="rk3588s-lubancat-4"
CONFIG_SPL_OF_LIST="rk3588s-lubancat-4"
# CONFIG_OF_UPSTREAM is not set
CONFIG_BOOTDELAY=3
CONFIG_BAUDRATE=1500000
CONFIG_SYS_I2C_ROCKCHIP=y
CONFIG_SPI=y
CONFIG_ROCKCHIP_SPI=y
CONFIG_DM_PMIC=y
CONFIG_PMIC_RK8XX=y
CONFIG_DM_REGULATOR=y
CONFIG_REGULATOR_RK8XX=y
CONFIG_CMD_REGULATOR=y
# 本阶段从 SD/extlinux 启动，不生成 UEFI 更新胶囊，避免额外宿主 GnuTLS 依赖。
# CONFIG_TOOLS_MKEFICAPSULE is not set
