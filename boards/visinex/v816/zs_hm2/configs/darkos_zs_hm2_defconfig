# zs_hm2 的 Buildroot defconfig；GCC/headers/路径/前缀各会由 BSP_ROOTFS_EXTERNAL_AUTO
# 按实际工具链自动改写，无需手工维护。使用方法：复制改名为 darkos_zs_hm2_defconfig。
BR2_aarch64=y
# CPU 核型号按芯片替换（如 rk3588s 为 cortex_a76_a55）。
BR2_cortex_a76_a55=y
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_GCC_13=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_1=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TARGET_GENERIC_HOSTNAME="darkos-zs_hm2"
BR2_TARGET_GENERIC_ISSUE="DarkOS zs_hm2 development system"
# 调试串口按板卡实际修改；速率非标准值时保留 BAUDRATE_KEEP 并在内核命令行指定。
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_DARKOS_BSP_INFO=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
# 内核和 U-Boot 由 BSP 脚本单独构建，这里不重复编。
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_UBOOT is not set
